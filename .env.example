# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Supabase project URL. NOT a secret: the browser sends it on every request
# and it is embedded in the frontend bundle. Tokens are verified with the
# public key from this project's JWKS endpoint, so no JWT secret and no
# service key are needed by the API.
SUPABASE_URL=https://ptjqeuqmlqldlnudovff.supabase.co

# Local Postgres. Replace with the Supabase connection string when moving
# off the local container -- that one IS a secret.
DATABASE_URL=postgresql+psycopg://postgres:scamsathi@db:5432/scamsathi

# Set to 0 only for load testing.
RATE_LIMIT_ENABLED=1
